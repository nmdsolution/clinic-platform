{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0"
  },
  "pages": [
    {
      "component": "root",
      "route": "tableau-de-bord"
    },
    {
      "component": "patientsModule",
      "route": "patients"
    },
    {
      "component": "medicamentsModule",
      "route": "medicaments"
    },
    {
      "component": "ventesModule",
      "route": "ventes"
    }
  ],
  "extensions": [
    {
      "name": "barre-modules",
      "component": "barreModules",
      "slot": "top-nav-info-slot",
      "online": true,
      "offline": false
    },
    {
      "name": "assistant-ia",
      "component": "assistantBouton",
      "slot": "top-nav-actions-slot",
      "online": true,
      "offline": false
    }
  ]
}
